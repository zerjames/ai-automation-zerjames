# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class
*.so

# Environments
.env
.venv
env/
venv/
ENV/

# Output Excel reports (jangan commit file hasil generate ke repo)
output/*.xlsx
output/scheduled_reports/
!output/.gitkeep

# Database file (akan digenerate otomatis saat aplikasi pertama kali dijalankan)
data/*.db
!data/.gitkeep

# IDE & OS temporary files
.DS_Store
Thumbs.db

